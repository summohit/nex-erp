# NEX ERP — backend environment
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# Derived from every `process.env.*` read in backend/src and backend/prisma.
# Never commit the filled-in .env.

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase pooler URL (port 6543) for the app. deploy.sh rewrites this to the
# direct port (5432) for Prisma migrations, since the pooler can't run DDL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma connection pool. Defaults: max 15, min 2 (min keeps connections warm
# to cut cold-start latency).
DB_POOL_MAX=15
DB_POOL_MIN=2

# ─── Server ──────────────────────────────────────────────────────────────────
# Defaults to 3000. Binds 0.0.0.0.
PORT=3000

# Public URL of the FRONTEND. Used to build links in outgoing email
# (verification, password reset, ticket links). Defaults to http://localhost:4200.
APP_URL="http://localhost:4200"

# ─── Secrets — REQUIRED IN PRODUCTION ────────────────────────────────────────
# Both of these have insecure hard-coded fallbacks in the code. If unset, the
# app still boots but is trivially forgeable. See the notes below.

# Signs access and refresh tokens. Fallback: the literal 'super-secret'.
# Generate: openssl rand -base64 48
JWT_SECRET=""

# AES-256 key for encrypted columns. Must be 32 bytes as a 64-char hex string.
# Fallback: 64 zeros, i.e. no real encryption.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Email ───────────────────────────────────────────────────────────────────
# Two delivery paths. If BREVO_API_KEY is set the HTTP API is used and SMTP is
# skipped entirely — the API path has no IP allowlist, so prefer it off-server.
BREVO_API_KEY=""
# SENDINBLUE_API_KEY is accepted as a legacy alias for the above.

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Optional second transport, tried when the primary fails. If unset and the
# primary is Brevo on 587, the app auto-adds Brevo on 465 (TLS) as a fallback.
SMTP_FALLBACK_HOST=""
SMTP_FALLBACK_PORT=""
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_USER=""
SMTP_FALLBACK_PASS=""

# Envelope sender. Falls back to SMTP_USER, then noreply@nexerp.com.
FROM_EMAIL=""
# Separate sender used only by payroll payslip mail. Default payroll@ces-pl.com.
SMTP_FROM=""

# ─── File uploads (ImageKit) ─────────────────────────────────────────────────
# Only the private key is read server-side (used to sign the upload auth
# header). The public key and endpoint are client-side config.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# ─── AI features ─────────────────────────────────────────────────────────────
# Used by AI project generation, document analysis and résumé scoring.
# Features degrade rather than crash when these are absent.
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ─── Seeding (optional, local only) ──────────────────────────────────────────
# prisma/seed_field_visits.ts attaches generated visits to this login so they
# show up for the account you actually sign in with.
SEED_EMPLOYEE_EMAIL=""
