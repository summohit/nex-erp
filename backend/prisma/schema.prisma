generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// SaaS Tenant
model Company {
  id                  Int                  @id @default(autoincrement())
  name                String
  domain              String?              @unique
  logoUrl             String?
  industry            String?
  size                String?
  timezone            String?
  onboardingCompleted Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  employees           Employee[]
  departments         Department[]
  designations        Designation[]
  rolePermissions     RolePermission[]
  onboardingTemplates OnboardingTemplate[]
  branches            Branch[]
  holidays            Holiday[]
  leaveTypes          LeaveType[]
  shifts              Shift[]
  salaryComponents    SalaryComponent[]
  expenseClaims       ExpenseClaim[]
  awardTypes          AwardType[]
  appreciations       Appreciation[]
    assets              Asset[]
    assetAssignments    AssetAssignment[]
    hardwareRequests    HardwareRequest[]
    inventoryItems      InventoryItem[]
    inventoryTransactions InventoryTransaction[]
  jobs                Job[]
  jobApplications     JobApplication[]
  projects            Project[]
  issues              Issue[]
  notifications       Notification[]
  appRoles            AppRole[]
  featureFlags        FeatureFlag[]
  approvalWorkflows   ApprovalWorkflow[]
  performanceGoals    PerformanceGoal[]
  performanceReviews  PerformanceReview[]
  companyOKRs         CompanyOKR[]
  appraisalCycles     AppraisalCycle[]
  peerFeedbacks       PeerFeedback[]
  resignations        Resignation[]
  exitInterviews      ExitInterview[]
  offboardingTasks    OffboardingTask[]
  shiftRotations      ShiftRotation[]
  blackoutDates       BlackoutDate[]
  clients             Client[]
  kioskEnabled        Boolean              @default(false)
  payrollSetting      PayrollSetting?
  systemSetting       SystemSetting?
  baseCurrency        String               @default("USD")
  leads               Lead[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  fieldVisits         FieldVisit[]         @relation("CompanyFieldVisits")
  leadFollowUps       LeadFollowUp[]
  leadContacts        LeadContact[]
  leadFiles           LeadFile[]
  leadNotes           LeadNote[]
  leadActivities      LeadActivity[]
  leadContactNotes    LeadContactNote[]
  leadForms           LeadForm[]
  offerLetters        OfferLetter[]
  tickets             Ticket[]
}

// Authentication & RBAC
model User {
  id                       Int                        @id @default(autoincrement())
  email                    String                     @unique
  password                 String
  role                     String                     @default("EMPLOYEE") // SUPERADMIN, ADMIN, HR, FINANCE, SALES, EMPLOYEE
  companyId                Int
  company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailVerifiedAt          DateTime?
  status                   String                     @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, ACTIVE, SUSPENDED
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  employee                 Employee?
  approvedLeaveRequests    LeaveRequest[]
  approvedExpenseClaims    ExpenseClaim[]             @relation("ExpenseApprover")
  approvedHardwareRequests HardwareRequest[]          @relation("HardwareApprover")
  createdInventoryTxns     InventoryTransaction[]     @relation("InventoryCreatedBy")
  notifications            Notification[]
  userRoles                UserRole[]
  userMenuBookmarks        UserMenuBookmark[]
  approvedResignations     Resignation[]              @relation("ResignationApprover")
  conductedExitInterviews  ExitInterview[]            @relation("ExitInterviewer")
  clearedOffboardingTasks  OffboardingTask[]          @relation("TaskClearer")
  approvedRegularizations  AttendanceRegularization[]
  approvedQuotations       Quotation[]                @relation("QuotationApprover")
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String // email address
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

// Roles & Permissions
model RolePermission {
  id        Int      @id @default(autoincrement())
  role      String // e.g., 'HR', 'ADMIN'
  module    String // e.g., 'EMPLOYEE_PROFILES'
  action    String // e.g., 'EDIT_ANY'
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module, action, companyId])
}

// Master Data
model Department {
  id            Int            @id @default(autoincrement())
  name          String
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isActive      Boolean        @default(true)
  defaultRole   String         @default("EMPLOYEE")
  designations  Designation[]
  employees     Employee[]
  jobs          Job[]
  blackoutDates BlackoutDate[]
  tickets       Ticket[]  @relation("TicketOwningTeam")
  raisedTickets Ticket[]  @relation("TicketRaisedByDept")
}

model Designation {
  id              Int         @id @default(autoincrement())
  name            String
  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isActive        Boolean     @default(true)
  canEditProfiles Boolean     @default(false)
  employees       Employee[]
  jobs            Job[]
}

// Core Employee Profile
model Employee {
  id               Int          @id @default(autoincrement())
  firstName        String
  lastName         String
  departmentId     Int?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId    Int?
  designation      Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  phone            String?
  userId           Int          @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        Int
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         Int?
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  managerId        Int?
  manager          Employee?    @relation("EmployeeToManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates     Employee[]   @relation("EmployeeToManager")
  shiftId          Int?
  shift            Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  isProjectManager Boolean      @default(false)

  employmentType String?
  joiningDate    DateTime?

  employeeCode       String? // Human-readable ID: plain number for permanent staff, T-prefixed for trainees, C-prefixed for contractors
  employmentCategory String  @default("PERMANENT") // PERMANENT, TRAINEE, CONTRACT

  onboardingStatus String                   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  onboardingTasks  EmployeeOnboardingTask[]
  kioskPin         String? // 4-digit PIN for Kiosk Mode
  recruitedJobs    Job[]                    @relation("JobRecruiter")

  // Profile details
  salutation    String?
  country       String?
  state         String?
  city          String?
  language      String?
  gender        String?
  dateOfBirth   DateTime?
  slackId       String?
  maritalStatus String?
  address       String?
  about         String?

  // Bank Details
  bankName          String?
  bankAccountNumber String?
  ifscCode          String?

  // Place of Birth
  placeOfBirthCity    String?
  placeOfBirthCountry String?

  // Citizenship & Identification
  nationality      String?
  identificationNo String?
  passportNo       String?

  // Visa & Work Permit
  visaNo       String?
  workPermitNo String?

  // Location & Distance
  zipCode            String?
  homeWorkDistanceKm Float?

  // Family Details
  spouseName      String?
  spouseBirthdate DateTime?
  childrenCount   Int?

  // Education
  educationLevel String?
  fieldOfStudy   String?

  // Preferences
  avatarUrl String?
  themePref String? @default("system")
  currency  String? @default("USD")

  // Work Location & Notes
  usualWorkLocation Json?
  workNotes         String?
  nextAppraisalDate DateTime?
  offboardingStatus String    @default("NONE") // NONE, IN_PROGRESS, SEPARATED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyContacts EmergencyContact[]
  documents         EmployeeDocument[]
  leaveBalances     LeaveBalance[]
  appreciations     Appreciation[]
  leaveRequests     LeaveRequest[]
  attendances       Attendance[]
  salaryStructures  SalaryStructure[]
  payslips          Payslip[]
  expenseClaims     ExpenseClaim[]
  assetAssignments  AssetAssignment[]
  inventoryTxns     InventoryTransaction[]
  hardwareRequests  HardwareRequest[]
  interviews        Interview[]
  skills            EmployeeSkill[]
  resumeLines       EmployeeResume[]

  ledProjects              Project[]                  @relation("ProjectLead")
  projectMembers           ProjectMember[]
  assignedIssues           Issue[]                    @relation("IssueAssignee")
  reportedIssues           Issue[]                    @relation("IssueReporter")
  cardMemberships          IssueMember[]
  issueTimeLogs            IssueTimeLog[]
  issueComments            IssueComment[]
  uploadedAttachments      IssueAttachment[]
  issueActivities          IssueActivity[]
  performanceGoals         PerformanceGoal[]
  reviewsGiven             PerformanceReview[]        @relation("Reviewer")
  reviewsReceived          PerformanceReview[]        @relation("Reviewee")
  resignations             Resignation[]
  exitInterviews           ExitInterview[]
  offboardingTasks         OffboardingTask[]
  regularizations          AttendanceRegularization[]
  shiftRotations           ShiftRotation[]
  uploadedProjectDocuments ProjectDocument[]
  assignedLeads            Lead[]                     @relation("LeadAssignee")
  createdLeads             Lead[]                     @relation("LeadCreator")
  peerReviewsGiven         PeerFeedback[]             @relation("PeerReviewer")
  peerReviewsReceived      PeerFeedback[]             @relation("PeerReviewee")
  fieldVisits              FieldVisit[]               @relation("EmployeeFieldVisits")
  followUpsAssigned        LeadFollowUp[]             @relation("FollowUpAssignee")
  leadContactsAdded        LeadContact[]              @relation("LeadContactAddedBy")
  leadFilesUploaded        LeadFile[]                 @relation("LeadFileUploader")
  leadNotesCreated         LeadNote[]                 @relation("LeadNoteCreator")
  leadActivities           LeadActivity[]             @relation("LeadActivityActor")
  leadContactNotesCreated  LeadContactNote[]          @relation("LeadContactNoteCreator")
  leadFormsCreated         LeadForm[]                 @relation("LeadFormCreator")
  reportedTickets          Ticket[]                   @relation("TicketReporter")
  assignedTickets          Ticket[]                   @relation("TicketAssignee")
  ticketComments           TicketComment[]            @relation("TicketCommentAuthor")
  ticketAttachments        TicketAttachment[]         @relation("TicketAttachmentUploader")
  ticketActivities         TicketActivity[]           @relation("TicketActivityActor")
  ticketTimeEntries        TicketTimeEntry[]

  @@unique([companyId, employeeCode])
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  mobile       String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmployeeDocument {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  documentType String?  @default("Other")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Onboarding
model OnboardingTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeOnboardingTask {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Master Data: Branches & Holidays
model Branch {
  id             Int        @id @default(autoincrement())
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  startTime      String     @default("09:00")
  endTime        String     @default("18:00")
  weeklyOffs     String     @default("0") // Comma separated integers: 0=Sun, 1=Mon, ..., 6=Sat
  isActive       Boolean    @default(true)
  companyId      Int
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  geofenceRadius Int?       @default(500) // meters
  allowedIps     String? // Comma-separated list of allowed IPs
  employees      Employee[]
  jobs           Job[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Attendance & Leaves
model LeaveType {
  id                Int            @id @default(autoincrement())
  name              String
  description       String?
  defaultDays       Int            @default(0)
  accrualFrequency  String? // NONE, MONTHLY, YEARLY
  accrualAmount     Float          @default(0)
  isPaid            Boolean        @default(true)
  allowHalfDay      Boolean        @default(true)
  carryForward      Boolean        @default(false)
  carryForwardLimit Int            @default(0)
  companyId         Int
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  allocated   Float     @default(0)
  used        Float     @default(0)
  carriedOver Float     @default(0)
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     Int
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  isHalfDay       Boolean   @default(false)
  halfDayPeriod   String? // AM, PM
  reason          String?
  attachmentUrl   String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  approvedById    Int?
  approvedBy      User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Attendance {
  id            Int             @id @default(autoincrement())
  employeeId    Int
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime        @db.Date
  clockIn       DateTime?
  clockOut      DateTime?
  clockInLat    Float?
  clockInLng    Float?
  clockOutLat   Float?
  clockOutLng   Float?
  overtimeHours Float           @default(0)
  status        String          @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  isLate        Boolean         @default(false)
  isEarlyLeave  Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  logs          AttendanceLog[]

  @@unique([employeeId, date])
}

model AttendanceLog {
  id           Int        @id @default(autoincrement())
  attendanceId Int
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  clockIn      DateTime
  clockOut     DateTime?
  clockInLat   Float?
  clockInLng   Float?
  clockOutLat  Float?
  clockOutLng  Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AttendanceRegularization {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime  @db.Date
  proposedClockIn  DateTime?
  proposedClockOut DateTime?
  reason           String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason  String?
  approvedById     Int?
  approvedBy       User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Shift {
  id                Int        @id @default(autoincrement())
  name              String
  startTime         String // format "HH:mm"
  endTime           String // format "HH:mm"
  bufferTimeMinutes Int        @default(15)
  companyId         Int
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees         Employee[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model ShiftRotation {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  rotationType String     @default("WEEKLY") // WEEKLY, BIWEEKLY, MONTHLY
  shiftIds     String // JSON array of shift IDs in order
  companyId    Int
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees    Employee[] // Employees assigned to this rotation
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Payroll & Expenses
model SalaryComponent {
  id               Int               @id @default(autoincrement())
  name             String
  type             String // EARNING or DEDUCTION
  isPreDefined     Boolean           @default(false)
  description      String?
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryStructures SalaryStructure[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SalaryStructure {
  id          Int             @id @default(autoincrement())
  employeeId  Int
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId Int
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  amount      Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, componentId])
}

model Payslip {
  id              Int           @id @default(autoincrement())
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int // 1-12
  year            Int
  workingDays     Int           @default(30)
  presentDays     Float         @default(0)
  absentDays      Float         @default(0)
  halfDays        Float         @default(0)
  totalEarnings   Float         @default(0)
  totalDeductions Float         @default(0)
  lossOfPay       Float         @default(0)
  expenseAmount   Float         @default(0)
  netPay          Float         @default(0)
  status          String        @default("DRAFT") // DRAFT, FINALIZED, PAID
  paidOn          DateTime?
  items           PayslipItem[]
  companyId       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, month, year])
}

model PayslipItem {
  id            Int      @id @default(autoincrement())
  payslipId     Int
  payslip       Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentName String
  type          String // EARNING, DEDUCTION, EXPENSE
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ExpenseClaim {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  amount          Float
  category        String    @default("OTHER") // TRAVEL, MEALS, ACCOMMODATION, EQUIPMENT, OTHER
  receiptUrl      String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  rejectionReason String?
  approvedById    Int?
  approvedBy      User?     @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month           Int?
  year            Int?
  purchaseDate    DateTime?
  purchasedFrom   String?
  projectCode     String?
  projectName     String?
  projectId       Int?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Appreciation & Awards
model AwardType {
  id            Int            @id @default(autoincrement())
  title         String
  icon          String         @default("trophy") // trophy, ribbon, star, award, gift, thumbsup
  color         String         @default("orange") // orange, purple, blue, green, red, yellow
  status        Boolean        @default(true)
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appreciations Appreciation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Appreciation {
  id          Int       @id @default(autoincrement())
  awardTypeId Int
  awardType   AwardType @relation(fields: [awardTypeId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  givenDate   DateTime
  summary     String    @db.Text
  photoUrl    String?
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Assets & IT Management
model Asset {
  id                Int               @id @default(autoincrement())
  assetTag          String
  name              String
  category          String            @default("LAPTOP") // LAPTOP, DESKTOP, MONITOR, PERIPHERAL, SOFTWARE, MOBILE, OTHER
  quantity          Int               @default(1)
  brand             String?
  model             String?
  serialNumber      String?
  purchaseDate      DateTime?
  cost              Float?
  warrantyExpiry    DateTime?
  images            String?           @db.Text
  location          String?
  notes             String?           @db.Text
  tags              String?           @db.Text
  status            String            @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_REPAIR, RETIRED
  ram               String? // e.g. "16GB", "32GB"
  storage           String? // e.g. "256GB SSD", "1TB NVMe"
  processor         String? // e.g. "Intel Core i7-1365U", "Apple M3 Max"
  companyId         Int
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments       AssetAssignment[]
  fulfilledRequests HardwareRequest[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model AssetAssignment {
  id                Int       @id @default(autoincrement())
  assetId           Int
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        Int
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate      DateTime  @default(now())
  returnDate        DateTime?
  conditionOnAssign String?
  conditionOnReturn String?
  notes             String?   @db.Text
  status            String    @default("ACTIVE") // ACTIVE, RETURNED
  companyId         Int
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// A standalone note attached to a Lead Contact (broker/partner/referrer).
// Separate from LeadNote which is scoped to a deal/lead. Supports CRUD and
// export from the Lead Contact Profile "Notes" tab.
model LeadContactNote {
  id           Int       @id @default(autoincrement())
  contactId    Int
  contact      LeadContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title        String
  type         String    @default("GENERAL") // GENERAL, CALL, MEETING, EMAIL, FOLLOW_UP, OTHER
  content      String    @db.Text
  createdById  Int?
  createdBy    Employee? @relation("LeadContactNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A configurable public Lead Capture Form (Lead Form Builder). Admins configure
// which fields are shown, their order, and required status; the form generates
// Leads into the existing Lead system via a public URL.
model LeadForm {
  id              Int             @id @default(autoincrement())
  formKey         String          @unique // public identifier (e.g. short base64 id) for /lead-form/:formKey
  name            String
  description     String?
  status          String          @default("ACTIVE") // ACTIVE, INACTIVE
  successMessage  String?         @default("Thank you! Your enquiry has been received.")
  redirectUrl     String?
  captchaEnabled  Boolean         @default(false)
  source          String          @default("Lead Form") // stamped on Lead.source for created leads
  productOptions  Json? // optional list of product options for the "Product" select field
  createdById     Int?
  createdBy       Employee?       @relation("LeadFormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fields          LeadFormField[]
  leadsCreated    Lead[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Field configuration for a LeadForm.
model LeadFormField {
  id        Int      @id @default(autoincrement())
  formId    Int
  form      LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  fieldKey  String // e.g. name, email, companyName, website, address, mobile, message, city, state, country, postalCode, source, product
  label     String
  type      String // text, email, tel, url, textarea, select
  enabled   Boolean  @default(true)
  required  Boolean  @default(false)
  isName    Boolean  @default(false) // the canonical Name field -> maps to Lead.title/contactName
  sortOrder Int      @default(0)
  options   Json? // for select fields (source, country, product)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HardwareRequest {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType      String   @default("NEW_DEVICE") // NEW_DEVICE, REPLACEMENT, REPAIR, PERIPHERAL
  category         String   @default("LAPTOP")
  urgency          String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  reason           String   @db.Text
  images           String?  @db.Text
  status           String   @default("PENDING") // PENDING, APPROVED, FULFILLED, REJECTED
  rejectionReason  String?
  fulfilledAssetId Int?
  fulfilledAsset   Asset?   @relation(fields: [fulfilledAssetId], references: [id], onDelete: SetNull)
  approvedById     Int?
  approvedBy       User?    @relation("HardwareApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Product/Batch-based Inventory (Assets & IT)
model InventoryItem {
  id             Int       @id @default(autoincrement())
  name           String
  brand          String?
  category       String    @default("OTHER") // LAPTOP, DESKTOP, MONITOR, PRINTER, PERIPHERAL, MOBILE, FURNITURE, PANTRY, STATIONERY, HOUSEKEEPING, OTHER
  itemType       String    @default("CONSUMABLE") // ASSET (non-perishable) | CONSUMABLE (perishable/quantified)
  unit           String    @default("units") // packets, pcs, boxes, bottles...
  quantity       Int       @default(0) // total purchased quantity (immutable; changed only via transactions)
  unitCost       Float     @default(0)
  purchaseDate   DateTime?
  supplier       String?
  batchNumber    String?
  expiryDate     DateTime?
  location       String?
  model          String?
  serialNumber   String?
  warrantyExpiry DateTime?
  notes          String?   @db.Text
  status         String    @default("ACTIVE") // ACTIVE, IN_REPAIR, RETIRED
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions   InventoryTransaction[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

// Transaction ledger against an InventoryItem. All quantities are derived from this history.
model InventoryTransaction {
  id                  Int                   @id @default(autoincrement())
  itemId              Int
  item                InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type                String                // PURCHASE, ASSIGNMENT, RETURN, CONSUMPTION, EXPIRED, ADJUSTMENT
  quantity            Int                   // units involved (signed for ADJUSTMENT)
  date                DateTime              @default(now())
  employeeId          Int?
  employee            Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assigneeText        String?               // free-text person/location e.g. "Pantry - 2nd Floor"
  expectedReturnDate  DateTime?
  parentTransactionId Int?                  // RETURN links back to its ASSIGNMENT
  parentTransaction   InventoryTransaction? @relation("InventoryTxnLink", fields: [parentTransactionId], references: [id], onDelete: SetNull)
  linkedReturns       InventoryTransaction[] @relation("InventoryTxnLink")
  purpose             String?
  conditionOnReturn   String?
  reason              String?               // adjustment/expiry reason
  createdById         Int?
  createdBy           User?                 @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  companyId           Int
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([itemId])
  @@index([companyId])
}

// Recruitment & ATS
model Job {
  id                 Int              @id @default(autoincrement())
  title              String
  departmentId       Int?
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId      Int?
  designation        Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branchId           Int?
  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  experienceYears    String?
  type               String           @default("Full-time")
  status             String           @default("Draft") // Open, Draft, Closed
  minSalary          Float?
  maxSalary          Float?
  discloseSalary     Boolean          @default(false)
  descriptionHtml    String?          @db.Text
  screeningQuestions String?          @db.Text // Store as JSON string or comma-separated
  requiredSkills     String[]         @default([])
  companyId          Int
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedDate         DateTime?
  startDate          DateTime?
  endDate            DateTime?
  totalOpenings      Int              @default(1)
  recruiterId        Int?
  recruiter          Employee?        @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  workLocationType   String           @default("On-site") // On-site, Remote, Hybrid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       JobApplication[]
}

model JobApplication {
  id              Int         @id @default(autoincrement())
  jobId           Int
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  phone           String
  resumeUrl       String?
  linkedinUrl     String?
  portfolioUrl    String?
  experienceYears String?
  noticePeriod    String?
  skills          String[]      @default([])
  dateOfBirth     DateTime?
  gender          String?
  currentLocation String?
  currentCtc      Float?
  expectedCtc     Float?
  source          String?
  coverLetter     String?       @db.Text
  photoUrl        String?
  address         String?       @db.Text // Full postal address, printed on the offer letter
  joiningDate     DateTime? // Agreed date of joining, printed on the offer letter
  status          String        @default("NEW") // NEW, REVIEWING, SHORTLISTED, INTERVIEWING, OFFERED, REJECTED, HIRED, ONBOARDED
  rejectionReason String?       @db.Text
  offeredSalary   Float?
  approvalStatus  String?       @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED
  answers         String?       @db.Text // Store JSON string of answers
  aiScore         Int?
  aiSummary       String?       @db.Text
  isAiScored      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  interviews      Interview[]
  offerLetter     OfferLetter?
}

// A generated offer letter for a hired/offered candidate. v1 uses a single
// SuperAdmin-managed HTML template (System Settings) rather than a full
// merge-field engine, matching the payslip PDF generation pattern already
// used elsewhere in this codebase (Puppeteer + hardcoded HTML template).
model OfferLetter {
  id                    Int             @id @default(autoincrement())
  applicationId         Int             @unique
  application           JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId             Int
  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, DECLINED
  pdfUrl                String?
  accessToken           String          @unique // opaque token for the candidate accept/decline link
  issuedAt              DateTime?
  respondedAt           DateTime?
  
  // E-Signature Fields
  signatureName         String?
  signatureIp           String?
  signatureUserAgent    String?
  countersignedPdfUrl   String?
  signatureImage        String?   @db.Text // adopted signature as a data: URI
  signatureType         String?   // DRAWN | TYPED | UPLOADED
  initialsImage         String?   @db.Text

  // Signing audit trail
  unlockedAt            DateTime?
  viewedAt              DateTime?
  unlockAttempts        Int       @default(0)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Interview {
  id            Int            @id @default(autoincrement())
  applicationId Int
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId Int?
  interviewer   Employee?      @relation(fields: [interviewerId], references: [id], onDelete: SetNull)
  title         String // e.g. "Technical Round 1"
  scheduledAt   DateTime
  durationMins  Int            @default(30)
  locationUrl   String? // Google Meet / Zoom link
  status        String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  rating        Int? // Scorecard rating (1-5)
  feedback      String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ═══════════════════════════════════════════
// PROJECT MANAGEMENT MODULE
// ═══════════════════════════════════════════

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  key         String // Auto-generated, unique per company (e.g., "NEX")
  description String?
  color       String    @default("#2563eb") // Project accent color
  icon        String    @default("folder") // Lucide icon name
  status      String    @default("ACTIVE") // ACTIVE, ARCHIVED (lifecycle status — unrelated to workStatus)
  category    String? // free-text project category (e.g. "Implementation and Deployment")
  progress    Int? // 0-100 completion percentage
  workStatus  String? // NOT_STARTED, IN_PROGRESS, FINISHED (work status — distinct from ACTIVE/ARCHIVED)
  leadId      Int? // Project lead (Employee)
  lead        Employee? @relation("ProjectLead", fields: [leadId], references: [id])
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Client & Billing
  clientId     Int?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startDate    DateTime?
  endDate      DateTime?
  billingType  String    @default("NON_BILLABLE") // NON_BILLABLE, HOURLY, FIXED_PRICE
  budgetAmount Float?
  hourlyRate   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ProjectMember[]
  boards  Board[]
  issues  Issue[]
  labels  Label[]

  // AI Onboarding
  onboardingStatus String @default("DRAFT") // DRAFT, DOCUMENTS_UPLOADED, ANALYZING, ANALYZED, UNDER_REVIEW, CHANGES_REQUIRED, APPROVED, READY_FOR_KICKOFF, IN_PROGRESS, COMPLETED, ERROR

  documents     ProjectDocument[]
  analysisRuns  ProjectAnalysisRun[]
  fieldVisits   FieldVisit[]         @relation("ProjectFieldVisits")
  expenseClaims ExpenseClaim[]

  @@unique([key, companyId])
}

model ProjectDocument {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  url        String // ImageKit URL
  fileId     String? // ImageKit fileId
  type       String // MIME type or category (e.g. SOW, RFP)
  rawText    String?  @db.Text
  status     String   @default("PENDING") // PENDING, EXTRACTED, ERROR
  uploadedBy Int
  employee   Employee @relation(fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectAnalysisRun {
  id                 Int     @id @default(autoincrement())
  projectId          Int
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version            Int     @default(1)
  status             String  @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  aiModel            String  @default("llama3-70b-8192")
  promptVersion      String?
  documentsAnalyzed  Int     @default(0)
  processingDuration Int? // in milliseconds
  overallConfidence  Float?
  errorMessage       String? @db.Text

  // Validation & Normalization Layer
  totalCost          Float?
  costCurrency       String?
  costBreakdown      Json?
  costTotalMismatch  Boolean?
  estimatedRevenue   Float?
  estimatedMarginPct Float?
  marginDisplay      String?

  readinessScore  Int?
  healthStatus    String?
  healthBreakdown Json?

  validationWarnings Json?
  isReadyForKickoff  Boolean?
  kickoffBlockers    Json?

  resourceConstraints Json? // { engineerCount: number, maxDailyHours: number, daysOff: string[], startDate: string }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI Generated Entities
  summary          ProjectSummary?
  scope            ProjectScope?
  requirements     ProjectRequirement[]
  wbsTasks         ProjectWbsTask[]
  resourcePlans    ProjectResourcePlan[]
  costEstimate     ProjectCostEstimate?
  roadmap          ProjectRoadmap?
  milestones       ProjectMilestone[]
  risks            ProjectRisk[]
  dependencies     ProjectDependency[]
  assumptions      ProjectAssumption[]
  stakeholders     ProjectStakeholder[]
  raci             ProjectRaci[]
  openQuestions    ProjectOpenQuestion[]
  missingInfo      ProjectMissingInfo[]
  recommendations  ProjectRecommendation[]
  aiConfidence     ProjectAiConfidence?
  health           ProjectHealth?
  kickoffReadiness ProjectKickoffReadiness?
}

model ProjectSummary {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  executiveSummary  String @db.Text
  businessObjective String @db.Text
  projectGoals      String @db.Text
  projectType       String
  projectComplexity String
  projectPriority   String
  successCriteria   String @db.Text
}

model ProjectScope {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  inScope            String  @db.Text
  outOfScope         String  @db.Text
  deliverables       String  @db.Text
  features           String  @db.Text
  acceptanceCriteria String  @db.Text
  scopeConfidence    Float?
  scopeGaps          String? @db.Text
}

model ProjectRequirement {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title              String
  description        String  @db.Text
  category           String
  priority           String
  sourceDocument     String?
  sourceReference    String?
  acceptanceCriteria String? @db.Text
  confidence         Float?
  status             String  @default("AI_GENERATED")
  duplicateInfo      String? @db.Text
  type               String  @default("EXTRACTED")
}

model ProjectWbsTask {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  wbsId           String?
  phase           String
  module          String
  feature         String
  task            String
  subtask         String?
  description     String?   @db.Text
  estimatedEffort Float?
  quantity        Int?
  engineer        String?
  workingDays     Float?
  startDate       DateTime?
  startTime       String?
  endDate         DateTime?
  endTime         String?
  sourceReference String?
  remarks         String?   @db.Text
  dependencies    String?   @db.Text
  requiredSkill   String?
  requiredLevel   String?
  priority        String
}

model ProjectResourcePlan {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  role              String
  seniority         String?
  quantity          Int       @default(1)
  allocationPercent Int       @default(100)
  estimatedHours    Float?
  startDate         DateTime?
  endDate           DateTime?
  requiredSkills    String?   @db.Text
  responsibilities  String?   @db.Text
  reason            String?   @db.Text
  confidence        Float?
  type              String    @default("AI_ESTIMATED")
  status            String    @default("AI_GENERATED")
}

model ProjectCostEstimate {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  resourceCost       Float?
  infrastructureCost Float?
  vendorCost         Float?
  licenseCost        Float?
  otherCost          Float?
  contingency        Float?
  totalCost          Float?
  estimatedRevenue   Float?
  estimatedProfit    Float?
  estimatedMargin    Float?
  currency           String @default("USD")
  confidence         Float?
  type               String @default("AI_ESTIMATED")
}

model ProjectRoadmap {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  startDate          DateTime?
  completionDate     DateTime?
  estimatedDuration  Int? // in days
  phases             String    @db.Text // JSON string or text block
  criticalPath       String?   @db.Text
  scheduleConfidence Float?
}

model ProjectMilestone {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  name            String
  description     String?   @db.Text
  targetDate      DateTime?
  deliverables    String?   @db.Text
  dependencies    String?   @db.Text
  responsibleRole String?
  approvalReq     String?
  status          String    @default("AI_GENERATED")
}

model ProjectRisk {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  risk        String
  description String  @db.Text
  category    String
  probability String
  impact      String
  riskScore   Float?
  mitigation  String? @db.Text
  contingency String? @db.Text
  owner       String?
  source      String?
  confidence  Float?
  status      String  @default("AI_GENERATED")
}

model ProjectDependency {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  dependency       String
  type             String
  description      String?   @db.Text
  dependentTask    String?
  internalExternal String
  owner            String?
  dueDate          DateTime?
  impact           String?   @db.Text
  status           String    @default("AI_GENERATED")
}

model ProjectAssumption {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  assumption        String  @db.Text
  reason            String? @db.Text
  source            String?
  impactIfIncorrect String? @db.Text
  confidence        Float?
  status            String  @default("AI_GENERATED")
}

model ProjectStakeholder {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  stakeholder       String
  organization      String?
  role              String?
  influence         String?
  interest          String?
  responsibility    String? @db.Text
  communicationReq  String? @db.Text
  approvalAuthority Boolean @default(false)
}

model ProjectRaci {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  projectArea String
  responsible String?
  accountable String?
  consulted   String?
  informed    String?
}

model ProjectOpenQuestion {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  question        String  @db.Text
  category        String?
  importance      String?
  isBlocking      Boolean @default(false)
  source          String?
  suggestedAnswer String? @db.Text
  status          String  @default("OPEN")
}

model ProjectMissingInfo {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  missingItem String
  whyRequired String  @db.Text
  impact      String  @db.Text
  priority    String
  isBlocking  Boolean @default(false)
}

model ProjectRecommendation {
  id         Int                @id @default(autoincrement())
  analysisId Int
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  recommendation String  @db.Text
  category       String
  reason         String  @db.Text
  expectedImpact String  @db.Text
  confidence     Float?
  source         String?
  status         String  @default("AI_GENERATED")
}

model ProjectAiConfidence {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  scope        Float?
  requirements Float?
  timeline     Float?
  resourcePlan Float?
  cost         Float?
  riskAnalysis Float?
  overall      Float?
}

model ProjectHealth {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  readinessScore     Float?
  scopeScore         Float?
  requirementScore   Float?
  resourceScore      Float?
  budgetScore        Float?
  timelineScore      Float?
  riskScore          Float?
  documentationScore Float?
  healthStatus       String // HEALTHY, AT_RISK, CRITICAL
}

model ProjectKickoffReadiness {
  id         Int                @id @default(autoincrement())
  analysisId Int                @unique
  analysis   ProjectAnalysisRun @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  reqsApproved       Boolean @default(false)
  scopeApproved      Boolean @default(false)
  budgetApproved     Boolean @default(false)
  resourcesAvailable Boolean @default(false)
  timelineFeasible   Boolean @default(false)
  stakeholdersIded   Boolean @default(false)
  dependenciesIded   Boolean @default(false)
  risksReviewed      Boolean @default(false)
  docsAvailable      Boolean @default(false)
  clientApprovals    Boolean @default(false)
  overallStatus      String // READY, READY_WITH_CONDITIONS, NOT_READY
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  role       String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  isStarred  Boolean  @default(false)

  @@unique([projectId, employeeId])
}

model Board {
  id        Int           @id @default(autoincrement())
  name      String        @default("Main Board")
  projectId Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
  createdAt DateTime      @default(now())
}

model BoardColumn {
  id         Int     @id @default(autoincrement())
  name       String // e.g. "To Do", "In Progress", "In Review", "Done"
  type       String  @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  color      String  @default("#6b7280") // Column header color
  position   Int // Sort order (0, 1, 2, ...)
  boardId    Int
  board      Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  issues     Issue[]
  isSystem   Boolean @default(false)
  isArchived Boolean @default(false)

  @@unique([boardId, position])
}

model Issue {
  id             Int       @id @default(autoincrement())
  key            String // Auto-generated: "NEX-1", "NEX-2"
  title          String
  description    String?   @db.Text // Quill HTML content
  type           String    @default("TASK") // EPIC, STORY, TASK, BUG, SUBTASK
  status         String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE, CANCELLED
  priority       String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  storyPoints    Int?
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float?
  recurring      String?
  dueReminder    String?
  coverUrl       String?
  position       Int       @default(0) // Sort order within column/backlog
  isArchived     Boolean   @default(false)
  isLate         Boolean   @default(false)

  // Time Tracking Markers
  workStartedAt   DateTime? // When work actually started
  workCompletedAt DateTime? // When work actually finished

  // Review System
  rejectionReason String? @db.Text

  // Relationships
  projectId  Int
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId   Int?
  column     BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assigneeId Int?
  assignee   Employee?    @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId Int?
  reporter   Employee?    @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parentId   Int? // For sub-tasks and Epic→Story linking
  parent     Issue?       @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Issue[]      @relation("IssueHierarchy")
  companyId  Int
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comments    IssueComment[]
  attachments IssueAttachment[]
  labels      IssueLabel[]
  members     IssueMember[]
  activities  IssueActivity[]
  timeLogs    IssueTimeLog[] // Detailed time entries if multiple sessions
  checklists  Checklist[]
  reminders   IssueReminder[] // Sent due-date reminder markers (dedupe)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, companyId])
}

// Support multiple work sessions if a user stops and starts
// Tracks which due-date reminders have already been sent for an issue (prevents duplicates)
model IssueReminder {
  id        Int      @id @default(autoincrement())
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  threshold String // "DAY_7", "DAY_3", "DAY_2", "DAY_1", "HOUR_4", "HOUR_3", "HOUR_90MIN", "DUE"
  companyId Int
  sentAt    DateTime @default(now())

  @@unique([issueId, threshold])
}

model IssueTimeLog {
  id          Int       @id @default(autoincrement())
  issueId     Int
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int? // Calculated duration in minutes
  createdAt   DateTime  @default(now())
}

model IssueComment {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text // Quill HTML content
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  Int
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueAttachment {
  id         Int      @id @default(autoincrement())
  fileName   String
  fileUrl    String
  fileSize   Int? // bytes
  fileType   String   @default("FILE") // FILE or LINK
  isCover    Boolean  @default(false)
  issueId    Int
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy Int
  uploader   Employee @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Label {
  id        Int          @id @default(autoincrement())
  name      String // e.g. "Frontend", "Backend", "Design", "Urgent"
  color     String       @default("#6b7280")
  projectId Int
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]
}

model IssueLabel {
  id      Int   @id @default(autoincrement())
  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId Int
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
}

model IssueActivity {
  id        Int      @id @default(autoincrement())
  action    String // "STATUS_CHANGED", "ASSIGNED", "COMMENT_ADDED", "PRIORITY_CHANGED", "WORK_STARTED", "WORK_STOPPED"
  field     String? // Which field changed
  oldValue  String?
  newValue  String?
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     Employee @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Checklist {
  id        Int             @id @default(autoincrement())
  title     String
  issueId   Int
  issue     Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ChecklistItem {
  id          Int       @id @default(autoincrement())
  title       String
  isCompleted Boolean   @default(false)
  checklistId Int
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IssueMember {
  issueId    Int
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([issueId, employeeId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, LEAVE_REQUEST, ASSIGNMENT, PAYROLL
  linkUrl   String?
  isRead    Boolean  @default(false)
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- NEW RBAC & DYNAMIC MENUS (Architecture V2) ---

model AppRole {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean             @default(false)
  priority    Int                 @default(0) // Higher number = higher precedence
  users       UserRole[]
  permissions AppRolePermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model UserRole {
  id           Int     @id @default(autoincrement())
  userId       Int
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       Int
  role         AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  companyId    Int?
  branchId     Int?
  departmentId Int?

  @@unique([userId, roleId])
}

model PermissionDefinition {
  id           Int                 @id @default(autoincrement())
  resourceType String
  resourceName String
  action       String
  roles        AppRolePermission[]
  menus        Menu[]
}

model AppRolePermission {
  id           Int                  @id @default(autoincrement())
  roleId       Int
  role         AppRole              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String               @default("ALLOW")
  condition    Json?

  @@unique([roleId, permissionId])
}

model FeatureFlag {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, key])
}

model Menu {
  id             Int                   @id @default(autoincrement())
  companyId      Int?
  parentId       Int?
  parent         Menu?                 @relation("MenuHierarchy", fields: [parentId], references: [id])
  children       Menu[]                @relation("MenuHierarchy")
  title          String
  icon           String?
  route          String?
  externalUrl    String?
  openInNewTab   Boolean               @default(false)
  displayOrder   Int                   @default(0)
  isActive       Boolean               @default(true)
  featureFlagKey String?
  requiredPermId Int?
  requiredPerm   PermissionDefinition? @relation(fields: [requiredPermId], references: [id])
  bookmarks      UserMenuBookmark[]
}

model UserMenuBookmark {
  id          Int     @id @default(autoincrement())
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuId      Int
  menu        Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  isFavorite  Boolean @default(false)
  isHidden    Boolean @default(false)
  customOrder Int?

  @@unique([userId, menuId])
}

model ApprovalWorkflow {
  id           Int            @id @default(autoincrement())
  companyId    Int
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType String
  conditions   Json?
  steps        ApprovalStep[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ApprovalStep {
  id           Int              @id @default(autoincrement())
  workflowId   Int
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverType String
  roleId       Int?
  isParallel   Boolean          @default(false)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  actorId    Int?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model EmployeeSkill {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category   String
  name       String
  level      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmployeeResume {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String // 'Experience' | 'Education' | 'Certification'
  title         String
  organization  String
  startDate     String?
  endDate       String?
  description   String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════
// PERFORMANCE MANAGEMENT MODULE
// ═══════════════════════════════════════════

model PerformanceGoal {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  description  String?     @db.Text
  status       String      @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, MISSED
  dueDate      DateTime?
  progress     Int         @default(0) // 0-100 percentage
  targetValue  Float? // e.g. 100000 (₹1L target)
  currentValue Float?      @default(0) // e.g. 75000 (₹75K current)
  unit         String? // "₹", "%", "units", "deals", "projects"
  okrId        Int?
  okr          CompanyOKR? @relation(fields: [okrId], references: [id], onDelete: SetNull)
  companyId    Int
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model PerformanceReview {
  id           Int                @id @default(autoincrement())
  employeeId   Int
  employee     Employee           @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   Int?
  reviewer     Employee?          @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  cycleId      Int?
  cycle        AppraisalCycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  cycleName    String
  type         String             @default("MANAGER") // MANAGER, SELF, PEER
  rating       Int?
  feedback     String?            @db.Text
  selfRating   Int? // Employee's self-rating (1-5)
  selfFeedback String?            @db.Text // Employee's self-assessment
  status       String             @default("PENDING_SELF_REVIEW")
  // Status flow: PENDING_SELF_REVIEW → SELF_REVIEWED → MANAGER_REVIEWED → ACKNOWLEDGED → HR_APPROVED
  signoffs     AppraisalSignoff[]
  companyId    Int
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CompanyOKR {
  id          Int               @id @default(autoincrement())
  title       String // "Increase Revenue by 40%"
  description String?           @db.Text
  period      String // "Q1 2026", "H1 2026", "FY 2026-27"
  status      String            @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  progress    Int               @default(0) // 0-100 auto-calculated from key results
  companyId   Int
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById Int?
  keyResults  OKRKeyResult[]
  linkedGoals PerformanceGoal[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model OKRKeyResult {
  id           Int        @id @default(autoincrement())
  okrId        Int
  okr          CompanyOKR @relation(fields: [okrId], references: [id], onDelete: Cascade)
  title        String // "Close 50 enterprise deals"
  targetValue  Float // 50
  currentValue Float      @default(0) // 32
  unit         String     @default("units") // "₹", "%", "units", "deals"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AppraisalCycle {
  id        Int                 @id @default(autoincrement())
  name      String // "H1 2026 Performance Review"
  startDate DateTime
  endDate   DateTime
  status    String              @default("ACTIVE") // ACTIVE, COMPLETED, CLOSED
  companyId Int
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviews   PerformanceReview[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model AppraisalSignoff {
  id         Int               @id @default(autoincrement())
  reviewId   Int
  review     PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  signedById Int // Employee ID who signed
  role       String // EMPLOYEE, MANAGER, HR
  action     String // APPROVED, ACKNOWLEDGED, REJECTED
  comments   String?           @db.Text
  signedAt   DateTime          @default(now())
}

model PeerFeedback {
  id           Int      @id @default(autoincrement())
  employeeId   Int // Employee being reviewed
  employee     Employee @relation("PeerReviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   Int // Peer who gives feedback
  reviewer     Employee @relation("PeerReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  cycleId      Int?
  cycleName    String
  rating       Int? // 1-5
  strengths    String?  @db.Text
  improvements String?  @db.Text
  comments     String?  @db.Text
  status       String   @default("PENDING") // PENDING, SUBMITTED
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Offboarding & Exit Management

model Resignation {
  id                     Int       @id @default(autoincrement())
  employeeId             Int
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId              Int
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason                 String    @db.Text
  intendedLastWorkingDay DateTime
  approvedLastWorkingDay DateTime?
  status                 String    @default("PENDING") // PENDING, APPROVED, REJECTED, WITHDRAWN
  approverId             Int?
  approver               User?     @relation("ResignationApprover", fields: [approverId], references: [id], onDelete: SetNull)
  remarks                String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model ExitInterview {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feedback      String    @db.Text
  rating        Int       @default(3) // 1-5
  interviewerId Int?
  interviewer   User?     @relation("ExitInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OffboardingTask {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department  String // IT, HR, FINANCE, ADMIN
  taskName    String
  description String?
  status      String   @default("PENDING") // PENDING, CLEARED
  clearedById Int?
  clearedBy   User?    @relation("TaskClearer", fields: [clearedById], references: [id], onDelete: SetNull)
  remarks     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlackoutDate {
  id           Int         @id @default(autoincrement())
  date         DateTime    @db.Date
  reason       String
  departmentId Int? // If null, applies to entire company
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  companyId    Int
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([date, departmentId, companyId])
}

// ═══════════════════════════════════════════
// CLIENT & CRM MODULE
// ═══════════════════════════════════════════

model Client {
  id       Int     @id @default(autoincrement())
  name     String // e.g., "Acme Corp"
  logo     String? // Client logo URL or base64
  industry String?
  website  String?

  // Status & Portal
  status        String  @default("ACTIVE") // LEAD, ACTIVE, INACTIVE, ARCHIVED
  portalEnabled Boolean @default(false) // Preparation for Zoho-style Client Portal

  // ─── Financial & Billing Details ───
  currency           String  @default("USD")
  paymentTerms       String? @default("Net 30") // Net 15, Net 30, Due on Receipt
  taxId              String? // VAT, GST, or EIN for invoicing
  registrationNo     String? // Company Registration Number
  defaultHourlyRate  Float? // Default billing rate for projects under this client
  creditLimit        Float? // Optional credit limit
  outstandingBalance Float?  @default(0.0) // Track unpaid invoices

  // ─── Addresses ───
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingZipCode      String?
  billingCountry      String?

  shippingSameAsBilling Boolean @default(true)
  shippingAddressLine1  String?
  shippingCity          String?
  shippingState         String?
  shippingZipCode       String?
  shippingCountry       String?

  // ─── Relations ───
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts    ClientContact[]
  projects    Project[]
  leads       Lead[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@unique([name, companyId])
}

model ClientContact {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String
  phone     String?
  mobile    String?
  jobTitle  String?

  isPrimary Boolean @default(false) // Primary contact
  isBilling Boolean @default(false) // Contact who receives the invoices

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, clientId])
}

// Payroll Configuration
model PayrollSetting {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  basicPercent    Float    @default(50.0) // 50% of CTC
  hraPercent      Float    @default(20.0) // 20% of CTC
  pfPercent       Float    @default(12.0) // 12% of Basic
  gratuityPercent Float    @default(4.81) // 4.81% of Basic
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// SuperAdmin-controlled, company-wide system toggles.
model SystemSetting {
  id                             Int      @id @default(autoincrement())
  companyId                      Int      @unique
  company                        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shiftRosterVisibleToEmployees  Boolean  @default(false)
  offerLetterTemplateHtml        String?  @db.Text
  offerLetterTemplateDocxUrl     String?  // ImageKit URL for the uploaded Word Template
  // Company legal identity, statutory policy constants and salary-structure ratios
  // used to render offer letters. Kept as JSON so adding a clause doesn't require a
  // migration — see OfferLetterConfig in offer-letters.service.ts for the shape.
  offerLetterConfig              Json?
  defaultTicketAssigneeId        Int?     // Employee auto-assigned as default ticket assignee
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

// ═══════════════════════════════════════════
// SALES & CRM MODULE
// ═══════════════════════════════════════════

model Lead {
  id                  Int            @id @default(autoincrement())
  title               String
  subjectLine         String?
  dealCategory        String?        @default("Inbound") // Inbound, Outbound, Referral, Enterprise, Retainer
  companyName         String?
  contactName         String?
  email               String?
  phone               String?
  value               Float?
  currency            String?
  source              String?
  status              String         @default("NEW") // NEW, QUALIFIED, PROPOSAL, WON, LOST
  description         String?        @db.Text
  qualificationReason String?
  proposalDate        DateTime?
  assignedToId        Int?
  assignedTo          Employee?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  addedById           Int?
  addedBy             Employee?      @relation("LeadCreator", fields: [addedById], references: [id], onDelete: SetNull)
  broughtByContactId  Int? // External source (e.g. broker/partner) who brought this lead — alternative to addedBy
  broughtByContact    LeadContact?   @relation(fields: [broughtByContactId], references: [id], onDelete: SetNull)
  leadFormId          Int? // Lead Form that generated this lead (public capture forms)
  leadForm            LeadForm?      @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  expectedCloseDate   DateTime?
  website             String?
  address             String?        @db.Text
  companyId           Int
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId            Int?
  client              Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  quotations          Quotation[]
  followUps           LeadFollowUp[]
  files               LeadFile[]
  notes               LeadNote[]
  activities          LeadActivity[]
}

// External contact (broker/partner/referrer) who can be selected as the source
// of a lead via the "Lead Brought By" field, as an alternative to an internal Employee.
model LeadContact {
  id                Int       @id @default(autoincrement())
  salutation        String?
  name              String
  email             String?
  phone             String?
  leadSource        String?
  companyName       String?
  website           String?
  mobile            String?
  officePhoneNumber String?
  country           String?
  state             String?
  city              String?
  postalCode        String?
  address           String?   @db.Text
  addedById         Int?
  addedBy           Employee? @relation("LeadContactAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  companyId         Int
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  leadsBrought      Lead[]
  notes             LeadContactNote[]
}

// A follow-up is a single logged/scheduled interaction on a lead — a running
// activity note, not a task with a completion workflow. Whether it's "upcoming"
// or "past" is computed from `scheduledAt` vs now; there is no stored status.
model LeadFollowUp {
  id            Int       @id @default(autoincrement())
  leadId        Int
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title         String // e.g. "Follow-up call regarding pricing"
  contactPerson String? // Whom to follow up with
  contactPhone  String?
  contactEmail  String?
  type          String    @default("CALL") // CALL, MEETING, DEMO, EMAIL, FIELD_VISIT, NOTE, OTHER
  scheduledAt   DateTime // When this interaction is/was planned
  notes         String?   @db.Text // Agenda going in, remarks/outcome coming out — one running note
  status        String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  assignedToId  Int? // Responsible rep
  assignedTo    Employee? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LeadFile {
  id           Int       @id @default(autoincrement())
  leadId       Int
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String?
  fileSize     Int?
  uploadedById Int?
  uploadedBy   Employee? @relation("LeadFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model LeadNote {
  id           Int       @id @default(autoincrement())
  leadId       Int
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content      String    @db.Text
  createdById  Int?
  createdBy    Employee? @relation("LeadNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LeadActivity {
  id          Int       @id @default(autoincrement())
  leadId      Int
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action      String
  description String?
  actorId     Int?
  actor       Employee? @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata    Json?
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Quotation {
  id             Int             @id @default(autoincrement())
  quoteNumber    String
  clientId       Int
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId         Int?
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  date           DateTime
  validUntil     DateTime
  subtotal       Float
  tax            Float
  taxRate        Float           @default(18)
  total          Float
  currency       String
  notes          String?
  terms          String?
  status         String          @default("DRAFT") // DRAFT, PENDING_APPROVAL, SENT, ACCEPTED, REJECTED
  approvalStatus String          @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedById   Int?
  approvedBy     User?           @relation("QuotationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          QuotationItem[]
  attachments    QuotationAttachment[]
  salesOrders    SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unit        String?
  unitPrice   Float
  total       Float
}

model QuotationAttachment {
  id           Int       @id @default(autoincrement())
  fileName     String
  fileUrl      String
  fileSize     Int?
  quotationId  Int
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model SalesOrder {
  id              Int              @id @default(autoincrement())
  orderNumber     String
  quotationId     Int?
  quotation       Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  clientId        Int
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            DateTime
  total           Float
  currency        String
  taxRate         Float            @default(0)
  paymentMethod   String?
  notes           String?
  status          String           @default("DRAFT") // DRAFT, CONFIRMED, DELIVERED, CANCELLED
  isRental        Boolean          @default(false)
  rentalStartDate DateTime?
  rentalEndDate   DateTime?
  rentalStatus    String? // ACTIVE, OVERDUE, RETURNED
  companyId       Int
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           SalesOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesOrderItem {
  id               Int        @id @default(autoincrement())
  salesOrderId     Int
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  description      String
  quantity         Float
  unit             String?
  unitPrice        Float
  discount         Float      @default(0)
  total            Float
  isRentalItem     Boolean    @default(false)
  returnedQuantity Float      @default(0)
}

// ═══════════════════════════════════════════
// FIELD VISITS
// ═══════════════════════════════════════════

model FieldVisit {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation("EmployeeFieldVisits", fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  Int
  project    Project  @relation("ProjectFieldVisits", fields: [projectId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company  @relation("CompanyFieldVisits", fields: [companyId], references: [id], onDelete: Cascade)

  startTime    DateTime
  startLat     Float
  startLng     Float
  startAddress String?

  endTime    DateTime?
  endLat     Float?
  endLng     Float?
  endAddress String?

  distanceKm   Float?
  durationMins Int?
  routePoints  Json? // Compact [[lat,lng,unixMs], ...] array

  status  String  @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  purpose String?
  notes   String?

  photos FieldVisitPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FieldVisitPhoto {
  id           Int        @id @default(autoincrement())
  fieldVisitId Int
  fieldVisit   FieldVisit @relation(fields: [fieldVisitId], references: [id], onDelete: Cascade)

  url     String
  takenAt DateTime
  caption String?

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════
// INTERNAL TICKETING MODULE
// ═══════════════════════════════════════════

enum TicketType {
  BUG
  FEATURE_REQUEST
  IMPROVEMENT
  QUESTION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketPlatform {
  WEB
  MOBILE
  BOTH
}

model Ticket {
  id           Int            @id @default(autoincrement())
  ticketNumber String         @unique
  title        String
  description  String?        @db.Text
  type         TicketType     @default(BUG)
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  platform     TicketPlatform @default(WEB)

  companyId    Int
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The team that works the ticket — always software development.
  departmentId Int
  department   Department     @relation("TicketOwningTeam", fields: [departmentId], references: [id])

  // The department the issue was raised on behalf of. Defaults to the reporter's
  // own department but is selectable, so IT can log a bug for Finance.
  raisedByDepartmentId Int?
  raisedByDepartment   Department? @relation("TicketRaisedByDept", fields: [raisedByDepartmentId], references: [id])

  reporterId   Int
  reporter     Employee       @relation("TicketReporter", fields: [reporterId], references: [id])

  assigneeId   Int?
  assignee     Employee?      @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  closedAt     DateTime?
  dueDate      DateTime?

  comments     TicketComment[]
  attachments  TicketAttachment[]
  activities   TicketActivity[]
  timeEntries  TicketTimeEntry[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@index([assigneeId])
  @@index([status])
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    Employee @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketAttachment {
  id           Int      @id @default(autoincrement())
  fileName     String
  fileUrl      String
  fileSize     Int?
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   Employee @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model TicketActivity {
  id        Int      @id @default(autoincrement())
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     Employee @relation("TicketActivityActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())
}

model TicketTimeEntry {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      Int
  user        Employee  @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // duration in seconds
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ticketId])
  @@index([userId])
}
