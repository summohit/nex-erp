model ProjectMember {
  id         Int      @id @default(autoincrement())
  role       String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  isStarred  Boolean  @default(false)

  @@unique([projectId, employeeId])
}

model Board {
  id        Int           @id @default(autoincrement())
  name      String        @default("Main Board")
  projectId Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
  createdAt DateTime      @default(now())
}

model BoardColumn {
  id         Int     @id @default(autoincrement())
  name       String // e.g. "To Do", "In Progress", "In Review", "Done"
  color      String  @default("#6b7280") // Column header color
  position   Int // Sort order (0, 1, 2, ...)
  boardId    Int
  board      Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  issues     Issue[]
  isSystem   Boolean @default(false)
  isArchived Boolean @default(false)

  @@unique([boardId, position])
}

model Issue {
  id             Int       @id @default(autoincrement())
  key            String // Auto-generated: "NEX-1", "NEX-2"
  title          String
  description    String?   @db.Text // Quill HTML content
  type           String    @default("TASK") // EPIC, STORY, TASK, BUG, SUBTASK
  status         String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE, CANCELLED
  priority       String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  storyPoints    Int?
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float?
  recurring      String?
  dueReminder    String?
  coverUrl       String?
  position       Int       @default(0) // Sort order within column/backlog
  isArchived     Boolean   @default(false)

  // Time Tracking Markers
  workStartedAt   DateTime? // When work actually started
  workCompletedAt DateTime? // When work actually finished

  // Relationships
  projectId  Int
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId   Int?
  column     BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assigneeId Int?
  assignee   Employee?    @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId Int?
  reporter   Employee?    @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parentId   Int? // For sub-tasks and Epic→Story linking
  parent     Issue?       @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Issue[]      @relation("IssueHierarchy")
  companyId  Int
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comments    IssueComment[]
  attachments IssueAttachment[]
  labels      IssueLabel[]
  members     IssueMember[]
  activities  IssueActivity[]
  timeLogs    IssueTimeLog[] // Detailed time entries if multiple sessions
  checklists  Checklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, companyId])
}

// Support multiple work sessions if a user stops and starts
model IssueTimeLog {
  id          Int       @id @default(autoincrement())
  issueId     Int
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int? // Calculated duration in minutes
  createdAt   DateTime  @default(now())
}

model IssueComment {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text // Quill HTML content
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  Int
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueAttachment {
  id         Int      @id @default(autoincrement())
  fileName   String
  fileUrl    String
  fileSize   Int? // bytes
  fileType   String   @default("FILE") // FILE or LINK
  isCover    Boolean  @default(false)
  issueId    Int
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy Int
  uploader   Employee @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Label {
  id        Int          @id @default(autoincrement())
  name      String // e.g. "Frontend", "Backend", "Design", "Urgent"
  color     String       @default("#6b7280")
  projectId Int
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]
}

model IssueLabel {
  id      Int   @id @default(autoincrement())
  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId Int
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
}

model IssueActivity {
  id        Int      @id @default(autoincrement())
  action    String // "STATUS_CHANGED", "ASSIGNED", "COMMENT_ADDED", "PRIORITY_CHANGED", "WORK_STARTED", "WORK_STOPPED"
  field     String? // Which field changed
  oldValue  String?
  newValue  String?
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     Employee @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Checklist {
  id        Int             @id @default(autoincrement())
  title     String
  issueId   Int
  issue     Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ChecklistItem {
  id          Int       @id @default(autoincrement())
  title       String
  isCompleted Boolean   @default(false)
  checklistId Int
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IssueMember {
  issueId    Int
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([issueId, employeeId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, LEAVE_REQUEST, ASSIGNMENT, PAYROLL
  linkUrl   String?
  isRead    Boolean  @default(false)
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- NEW RBAC & DYNAMIC MENUS (Architecture V2) ---

model AppRole {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean             @default(false)
  priority    Int                 @default(0) // Higher number = higher precedence
  users       UserRole[]
  permissions AppRolePermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model UserRole {
  id           Int     @id @default(autoincrement())
  userId       Int
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       Int
  role         AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  companyId    Int?
  branchId     Int?
  departmentId Int?

  @@unique([userId, roleId])
}

model PermissionDefinition {
  id           Int                 @id @default(autoincrement())
  resourceType String
  resourceName String
  action       String
  roles        AppRolePermission[]
  menus        Menu[]
}

model AppRolePermission {
  id           Int                  @id @default(autoincrement())
  roleId       Int
  role         AppRole              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String               @default("ALLOW")
  condition    Json?

  @@unique([roleId, permissionId])
}

model FeatureFlag {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, key])
}

model Menu {
  id             Int                   @id @default(autoincrement())
  companyId      Int?
  parentId       Int?
  parent         Menu?                 @relation("MenuHierarchy", fields: [parentId], references: [id])
  children       Menu[]                @relation("MenuHierarchy")
  title          String
  icon           String?
  route          String?
  externalUrl    String?
  openInNewTab   Boolean               @default(false)
  displayOrder   Int                   @default(0)
  isActive       Boolean               @default(true)
  featureFlagKey String?
  requiredPermId Int?
  requiredPerm   PermissionDefinition? @relation(fields: [requiredPermId], references: [id])
  bookmarks      UserMenuBookmark[]
}

model UserMenuBookmark {
  id          Int     @id @default(autoincrement())
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuId      Int
  menu        Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  isFavorite  Boolean @default(false)
  isHidden    Boolean @default(false)
  customOrder Int?

  @@unique([userId, menuId])
}

model ApprovalWorkflow {
  id           Int            @id @default(autoincrement())
  companyId    Int
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType String
