generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// SaaS Tenant
model Company {
  id                  Int                  @id @default(autoincrement())
  name                String
  domain              String?              @unique
  logoUrl             String?
  industry            String?
  size                String?
  timezone            String?
  onboardingCompleted Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  employees           Employee[]
  departments         Department[]
  designations        Designation[]
  rolePermissions     RolePermission[]
  onboardingTemplates OnboardingTemplate[]
  branches            Branch[]
  holidays            Holiday[]
  leaveTypes          LeaveType[]
  shifts              Shift[]
  salaryComponents    SalaryComponent[]
  expenseClaims       ExpenseClaim[]
  awardTypes          AwardType[]
  appreciations       Appreciation[]
  assets              Asset[]
  assetAssignments    AssetAssignment[]
  hardwareRequests    HardwareRequest[]
  jobs                Job[]
  jobApplications     JobApplication[]
  projects            Project[]
  issues              Issue[]
}

// Authentication & RBAC
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  role      String    @default("EMPLOYEE") // SUPERADMIN, ADMIN, HR, FINANCE, SALES, EMPLOYEE
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  employee  Employee?
  approvedLeaveRequests LeaveRequest[]
  approvedExpenseClaims ExpenseClaim[] @relation("ExpenseApprover")
  approvedHardwareRequests HardwareRequest[] @relation("HardwareApprover")
}

// Roles & Permissions
model RolePermission {
  id        Int      @id @default(autoincrement())
  role      String // e.g., 'HR', 'ADMIN'
  module    String // e.g., 'EMPLOYEE_PROFILES'
  action    String // e.g., 'EDIT_ANY'
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module, action, companyId])
}

// Master Data
model Department {
  id           Int           @id @default(autoincrement())
  name         String
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isActive     Boolean       @default(true)
  defaultRole  String        @default("EMPLOYEE")
  designations Designation[]
  employees    Employee[]
  jobs         Job[]
}

model Designation {
  id              Int         @id @default(autoincrement())
  name            String
  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isActive        Boolean     @default(true)
  canEditProfiles Boolean     @default(false)
  employees       Employee[]
  jobs            Job[]
}

// Core Employee Profile
model Employee {
  id            Int          @id @default(autoincrement())
  firstName     String
  lastName      String
  departmentId  Int?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId Int?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  phone         String?
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     Int
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  managerId     Int?
  manager       Employee?    @relation("EmployeeToManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  Employee[]   @relation("EmployeeToManager")
  shiftId       Int?
  shift         Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  onboardingStatus String                   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  onboardingTasks  EmployeeOnboardingTask[]

  // Profile details
  salutation    String?
  country       String?
  state         String?
  city          String?
  language      String?
  gender        String?
  dateOfBirth   DateTime?
  slackId       String?
  maritalStatus String?
  address       String?
  about         String?

  // Preferences
  avatarUrl String?
  themePref String? @default("system")
  currency  String? @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyContacts EmergencyContact[]
  documents         EmployeeDocument[]
  leaveBalances     LeaveBalance[]
  appreciations     Appreciation[]
  leaveRequests     LeaveRequest[]
  attendances       Attendance[]
  salaryStructures  SalaryStructure[]
  payslips          Payslip[]
  expenseClaims     ExpenseClaim[]
  assetAssignments  AssetAssignment[]
  hardwareRequests  HardwareRequest[]
  interviews        Interview[]

  ledProjects         Project[]          @relation("ProjectLead")
  projectMembers      ProjectMember[]
  assignedIssues      Issue[]            @relation("IssueAssignee")
  reportedIssues      Issue[]            @relation("IssueReporter")
  cardMemberships     IssueMember[]
  issueTimeLogs       IssueTimeLog[]
  issueComments       IssueComment[]
  uploadedAttachments IssueAttachment[]
  issueActivities     IssueActivity[]
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  mobile       String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmployeeDocument {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Onboarding
model OnboardingTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeOnboardingTask {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Master Data: Branches & Holidays
model Branch {
  id          Int        @id @default(autoincrement())
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  startTime   String     @default("09:00")
  endTime     String     @default("18:00")
  weeklyOffs  String     @default("0") // Comma separated integers: 0=Sun, 1=Mon, ..., 6=Sat
  companyId   Int
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  jobs        Job[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Holiday {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Attendance & Leaves
model LeaveType {
  id                Int             @id @default(autoincrement())
  name              String
  description       String?
  defaultDays       Int             @default(0)
  isPaid            Boolean         @default(true)
  carryForward      Boolean         @default(false)
  carryForwardLimit Int             @default(0)
  companyId         Int
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  allocated   Float     @default(0)
  used        Float     @default(0)
  carriedOver Float     @default(0)
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     Int
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String?
  attachmentUrl   String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  approvedById    Int?
  approvedBy      User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  clockIn     DateTime?
  clockOut    DateTime?
  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?
  status      String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  isLate      Boolean   @default(false)
  isEarlyLeave Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, date])
}

model Shift {
  id                 Int        @id @default(autoincrement())
  name               String
  startTime          String     // format "HH:mm"
  endTime            String     // format "HH:mm"
  bufferTimeMinutes  Int        @default(15)
  companyId          Int
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees          Employee[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

// Payroll & Expenses
model SalaryComponent {
  id               Int               @id @default(autoincrement())
  name             String
  type             String            // EARNING or DEDUCTION
  isPreDefined     Boolean           @default(false)
  description      String?
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryStructures SalaryStructure[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SalaryStructure {
  id          Int             @id @default(autoincrement())
  employeeId  Int
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId Int
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  amount      Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, componentId])
}

model Payslip {
  id              Int           @id @default(autoincrement())
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int           // 1-12
  year            Int
  workingDays     Int           @default(30)
  presentDays     Float         @default(0)
  absentDays      Float         @default(0)
  halfDays        Float         @default(0)
  totalEarnings   Float         @default(0)
  totalDeductions Float         @default(0)
  lossOfPay       Float         @default(0)
  expenseAmount   Float         @default(0)
  netPay          Float         @default(0)
  status          String        @default("DRAFT") // DRAFT, FINALIZED, PAID
  paidOn          DateTime?
  items           PayslipItem[]
  companyId       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, month, year])
}

model PayslipItem {
  id            Int      @id @default(autoincrement())
  payslipId     Int
  payslip       Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentName String
  type          String   // EARNING, DEDUCTION, EXPENSE
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ExpenseClaim {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  amount          Float
  category        String    @default("OTHER") // TRAVEL, MEALS, ACCOMMODATION, EQUIPMENT, OTHER
  receiptUrl      String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  approvedById    Int?
  approvedBy      User?     @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month           Int?
  year            Int?
  purchaseDate    DateTime?
  purchasedFrom   String?
  projectId       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Appreciation & Awards
model AwardType {
  id            Int            @id @default(autoincrement())
  title         String
  icon          String         @default("trophy") // trophy, ribbon, star, award, gift, thumbsup
  color         String         @default("orange") // orange, purple, blue, green, red, yellow
  status        Boolean        @default(true)
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appreciations Appreciation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Appreciation {
  id          Int       @id @default(autoincrement())
  awardTypeId Int
  awardType   AwardType @relation(fields: [awardTypeId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  givenDate   DateTime
  summary     String    @db.Text
  photoUrl    String?
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Assets & IT Management
model Asset {
  id                Int               @id @default(autoincrement())
  assetTag          String
  name              String
  category          String            @default("LAPTOP") // LAPTOP, DESKTOP, MONITOR, PERIPHERAL, SOFTWARE, MOBILE, OTHER
  brand             String?
  model             String?
  serialNumber      String?
  purchaseDate      DateTime?
  cost              Float?
  warrantyExpiry    DateTime?
  images            String?           @db.Text
  status            String            @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_REPAIR, RETIRED
  companyId         Int
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments       AssetAssignment[]
  fulfilledRequests HardwareRequest[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model AssetAssignment {
  id                Int       @id @default(autoincrement())
  assetId           Int
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        Int
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate      DateTime  @default(now())
  returnDate        DateTime?
  conditionOnAssign String?
  conditionOnReturn String?
  notes             String?   @db.Text
  status            String    @default("ACTIVE") // ACTIVE, RETURNED
  companyId         Int
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model HardwareRequest {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType      String    @default("NEW_DEVICE") // NEW_DEVICE, REPLACEMENT, REPAIR, PERIPHERAL
  category         String    @default("LAPTOP")
  urgency          String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  reason           String    @db.Text
  images           String?   @db.Text
  status           String    @default("PENDING") // PENDING, APPROVED, FULFILLED, REJECTED
  rejectionReason  String?
  fulfilledAssetId Int?
  fulfilledAsset   Asset?    @relation(fields: [fulfilledAssetId], references: [id], onDelete: SetNull)
  approvedById     Int?
  approvedBy       User?     @relation("HardwareApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId        Int
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Recruitment & ATS
model Job {
  id                 Int              @id @default(autoincrement())
  title              String
  departmentId       Int?
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId      Int?
  designation        Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branchId           Int?
  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  experienceYears    String?
  type               String           @default("Full-time")
  status             String           @default("Draft") // Open, Draft, Closed
  descriptionHtml    String?          @db.Text
  screeningQuestions String?          @db.Text // Store as JSON string or comma-separated
  companyId          Int
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedDate         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       JobApplication[]
}

model JobApplication {
  id          Int      @id @default(autoincrement())
  jobId       Int
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName    String
  email       String
  phone       String
  resumeUrl       String?
  linkedinUrl     String?
  portfolioUrl    String?
  experienceYears String?
  noticePeriod    String?
  status          String   @default("NEW") // NEW, REVIEWING, SHORTLISTED, REJECTED, HIRED, ONBOARDED
  answers         String?  @db.Text // Store JSON string of answers
  aiScore         Int?
  aiSummary       String?  @db.Text
  isAiScored      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  interviews      Interview[]
}

model Interview {
  id            Int            @id @default(autoincrement())
  applicationId Int
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId Int?
  interviewer   Employee?      @relation(fields: [interviewerId], references: [id], onDelete: SetNull)
  title         String         // e.g. "Technical Round 1"
  scheduledAt   DateTime
  durationMins  Int            @default(30)
  locationUrl   String?        // Google Meet / Zoom link
  status        String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  rating        Int?           // Scorecard rating (1-5)
  feedback      String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ═══════════════════════════════════════════
// PROJECT MANAGEMENT MODULE
// ═══════════════════════════════════════════

model Project {
  id            Int       @id @default(autoincrement())
  name          String
  key           String    // Auto-generated, unique per company (e.g., "NEX")
  description   String?
  color         String    @default("#2563eb") // Project accent color
  icon          String    @default("folder") // Lucide icon name
  status        String    @default("ACTIVE") // ACTIVE, ARCHIVED
  leadId        Int?      // Project lead (Employee)
  lead          Employee? @relation("ProjectLead", fields: [leadId], references: [id])
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       ProjectMember[]
  boards        Board[]
  issues        Issue[]
  labels        Label[]

  @@unique([key, companyId])
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  role       String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  isStarred  Boolean  @default(false)

  @@unique([projectId, employeeId])
}

model Board {
  id        Int      @id @default(autoincrement())
  name      String   @default("Main Board")
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
  createdAt DateTime @default(now())
}

model BoardColumn {
  id        Int      @id @default(autoincrement())
  name      String   // e.g. "To Do", "In Progress", "In Review", "Done"
  color     String   @default("#6b7280") // Column header color
  position  Int      // Sort order (0, 1, 2, ...)
  boardId   Int
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([boardId, position])
}

model Issue {
  id            Int       @id @default(autoincrement())
  key           String    // Auto-generated: "NEX-1", "NEX-2"
  title         String
  description   String?   @db.Text // Quill HTML content
  type          String    @default("TASK") // EPIC, STORY, TASK, BUG, SUBTASK
  status        String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE, CANCELLED
  priority      String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  storyPoints   Int?
  startDate     DateTime?
  dueDate       DateTime?
  recurring     String?
  dueReminder   String?
  coverUrl      String?
  position      Int       @default(0) // Sort order within column/backlog
  
  // Time Tracking Markers
  workStartedAt   DateTime? // When work actually started
  workCompletedAt DateTime? // When work actually finished

  // Relationships
  projectId     Int
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId      Int?
  column        BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assigneeId    Int?
  assignee      Employee? @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId    Int?
  reporter      Employee? @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parentId      Int?      // For sub-tasks and Epic→Story linking
  parent        Issue?    @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Issue[]   @relation("IssueHierarchy")
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comments      IssueComment[]
  attachments   IssueAttachment[]
  labels        IssueLabel[]
  members       IssueMember[]
  activities    IssueActivity[]
  timeLogs      IssueTimeLog[] // Detailed time entries if multiple sessions
  checklists    Checklist[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([key, companyId])
}

// Support multiple work sessions if a user stops and starts
model IssueTimeLog {
  id          Int       @id @default(autoincrement())
  issueId     Int
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?      // Calculated duration in minutes
  createdAt   DateTime  @default(now())
}

model IssueComment {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text // Quill HTML content
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  Int
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueAttachment {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileUrl   String
  fileSize  Int?     // bytes
  fileType  String   @default("FILE") // FILE or LINK
  isCover   Boolean  @default(false)
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy Int
  uploader  Employee @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Label {
  id        Int      @id @default(autoincrement())
  name      String   // e.g. "Frontend", "Backend", "Design", "Urgent"
  color     String   @default("#6b7280")
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]
}

model IssueLabel {
  id       Int   @id @default(autoincrement())
  issueId  Int
  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId  Int
  label    Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
}

model IssueActivity {
  id        Int      @id @default(autoincrement())
  action    String   // "STATUS_CHANGED", "ASSIGNED", "COMMENT_ADDED", "PRIORITY_CHANGED", "WORK_STARTED", "WORK_STOPPED"
  field     String?  // Which field changed
  oldValue  String?
  newValue  String?
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     Employee @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Checklist {
  id          Int      @id @default(autoincrement())
  title       String
  issueId     Int
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChecklistItem {
  id          Int      @id @default(autoincrement())
  title       String
  isCompleted Boolean  @default(false)
  checklistId Int
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IssueMember {
  issueId    Int
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([issueId, employeeId])
}


