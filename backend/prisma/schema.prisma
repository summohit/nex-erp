generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// SaaS Tenant
model Company {
  id                  Int                  @id @default(autoincrement())
  name                String
  domain              String?              @unique
  logoUrl             String?
  industry            String?
  size                String?
  timezone            String?
  onboardingCompleted Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  employees           Employee[]
  departments         Department[]
  designations        Designation[]
  rolePermissions     RolePermission[]
  onboardingTemplates OnboardingTemplate[]
  branches            Branch[]
  holidays            Holiday[]
  leaveTypes          LeaveType[]
  shifts              Shift[]
  salaryComponents    SalaryComponent[]
  expenseClaims       ExpenseClaim[]
  awardTypes          AwardType[]
  appreciations       Appreciation[]
  assets              Asset[]
  assetAssignments    AssetAssignment[]
  hardwareRequests    HardwareRequest[]
  jobs                Job[]
  jobApplications     JobApplication[]
  projects            Project[]
  issues              Issue[]
  notifications       Notification[]
  appRoles            AppRole[]
  featureFlags        FeatureFlag[]
  approvalWorkflows   ApprovalWorkflow[]
  performanceGoals    PerformanceGoal[]
  performanceReviews  PerformanceReview[]
  companyOKRs         CompanyOKR[]
  appraisalCycles     AppraisalCycle[]
  peerFeedbacks       PeerFeedback[]
  resignations        Resignation[]
  exitInterviews      ExitInterview[]
  offboardingTasks    OffboardingTask[]
  shiftRotations      ShiftRotation[]
  blackoutDates       BlackoutDate[]
  clients             Client[]
  kioskEnabled        Boolean              @default(false)
  payrollSetting      PayrollSetting?
  baseCurrency        String               @default("USD")
  leads               Lead[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
}

// Authentication & RBAC
model User {
  id                       Int                        @id @default(autoincrement())
  email                    String                     @unique
  password                 String
  role                     String                     @default("EMPLOYEE") // SUPERADMIN, ADMIN, HR, FINANCE, SALES, EMPLOYEE
  companyId                Int
  company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailVerifiedAt          DateTime?
  status                   String                     @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, ACTIVE, SUSPENDED
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  employee                 Employee?
  approvedLeaveRequests    LeaveRequest[]
  approvedExpenseClaims    ExpenseClaim[]             @relation("ExpenseApprover")
  approvedHardwareRequests HardwareRequest[]          @relation("HardwareApprover")
  notifications            Notification[]
  userRoles                UserRole[]
  userMenuBookmarks        UserMenuBookmark[]
  approvedResignations     Resignation[]              @relation("ResignationApprover")
  conductedExitInterviews  ExitInterview[]            @relation("ExitInterviewer")
  clearedOffboardingTasks  OffboardingTask[]          @relation("TaskClearer")
  approvedRegularizations  AttendanceRegularization[]
  approvedQuotations       Quotation[]                @relation("QuotationApprover")
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String // email address
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

// Roles & Permissions
model RolePermission {
  id        Int      @id @default(autoincrement())
  role      String // e.g., 'HR', 'ADMIN'
  module    String // e.g., 'EMPLOYEE_PROFILES'
  action    String // e.g., 'EDIT_ANY'
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module, action, companyId])
}

// Master Data
model Department {
  id            Int            @id @default(autoincrement())
  name          String
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isActive      Boolean        @default(true)
  defaultRole   String         @default("EMPLOYEE")
  designations  Designation[]
  employees     Employee[]
  jobs          Job[]
  blackoutDates BlackoutDate[]
}

model Designation {
  id              Int         @id @default(autoincrement())
  name            String
  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isActive        Boolean     @default(true)
  canEditProfiles Boolean     @default(false)
  employees       Employee[]
  jobs            Job[]
}

// Core Employee Profile
model Employee {
  id            Int          @id @default(autoincrement())
  firstName     String
  lastName      String
  departmentId  Int?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId Int?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  phone         String?
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     Int
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  managerId     Int?
  manager       Employee?    @relation("EmployeeToManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  Employee[]   @relation("EmployeeToManager")
  shiftId       Int?
  shift         Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  onboardingStatus String                   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  onboardingTasks  EmployeeOnboardingTask[]
  kioskPin         String? // 4-digit PIN for Kiosk Mode
  recruitedJobs    Job[]                    @relation("JobRecruiter")

  // Profile details
  salutation    String?
  country       String?
  state         String?
  city          String?
  language      String?
  gender        String?
  dateOfBirth   DateTime?
  slackId       String?
  maritalStatus String?
  address       String?
  about         String?

  // Bank Details
  bankName          String?
  bankAccountNumber String?
  ifscCode          String?

  // Place of Birth
  placeOfBirthCity    String?
  placeOfBirthCountry String?

  // Citizenship & Identification
  nationality      String?
  identificationNo String?
  passportNo       String?

  // Visa & Work Permit
  visaNo       String?
  workPermitNo String?

  // Location & Distance
  zipCode            String?
  homeWorkDistanceKm Float?

  // Family Details
  spouseName      String?
  spouseBirthdate DateTime?
  childrenCount   Int?

  // Education
  educationLevel String?
  fieldOfStudy   String?

  // Preferences
  avatarUrl String?
  themePref String? @default("system")
  currency  String? @default("USD")

  // Work Location & Notes
  usualWorkLocation Json?
  workNotes         String?
  nextAppraisalDate DateTime?
  offboardingStatus String    @default("NONE") // NONE, IN_PROGRESS, SEPARATED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyContacts EmergencyContact[]
  documents         EmployeeDocument[]
  leaveBalances     LeaveBalance[]
  appreciations     Appreciation[]
  leaveRequests     LeaveRequest[]
  attendances       Attendance[]
  salaryStructures  SalaryStructure[]
  payslips          Payslip[]
  expenseClaims     ExpenseClaim[]
  assetAssignments  AssetAssignment[]
  hardwareRequests  HardwareRequest[]
  interviews        Interview[]
  skills            EmployeeSkill[]
  resumeLines       EmployeeResume[]

  ledProjects              Project[]                  @relation("ProjectLead")
  projectMembers           ProjectMember[]
  assignedIssues           Issue[]                    @relation("IssueAssignee")
  reportedIssues           Issue[]                    @relation("IssueReporter")
  cardMemberships          IssueMember[]
  issueTimeLogs            IssueTimeLog[]
  issueComments            IssueComment[]
  uploadedAttachments      IssueAttachment[]
  issueActivities          IssueActivity[]
  performanceGoals         PerformanceGoal[]
  reviewsGiven             PerformanceReview[]        @relation("Reviewer")
  reviewsReceived          PerformanceReview[]        @relation("Reviewee")
  resignations             Resignation[]
  exitInterviews           ExitInterview[]
  offboardingTasks         OffboardingTask[]
  regularizations          AttendanceRegularization[]
  shiftRotations           ShiftRotation[]
  uploadedProjectDocuments ProjectDocument[]
  assignedLeads            Lead[]                     @relation("LeadAssignee")
  peerReviewsGiven         PeerFeedback[]             @relation("PeerReviewer")
  peerReviewsReceived      PeerFeedback[]             @relation("PeerReviewee")
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  mobile       String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmployeeDocument {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  documentType String?  @default("Other")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Onboarding
model OnboardingTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeOnboardingTask {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Master Data: Branches & Holidays
model Branch {
  id             Int        @id @default(autoincrement())
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  startTime      String     @default("09:00")
  endTime        String     @default("18:00")
  weeklyOffs     String     @default("0") // Comma separated integers: 0=Sun, 1=Mon, ..., 6=Sat
  isActive       Boolean    @default(true)
  companyId      Int
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  geofenceRadius Int?       @default(500) // meters
  allowedIps     String? // Comma-separated list of allowed IPs
  employees      Employee[]
  jobs           Job[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Attendance & Leaves
model LeaveType {
  id                Int            @id @default(autoincrement())
  name              String
  description       String?
  defaultDays       Int            @default(0)
  accrualFrequency  String? // NONE, MONTHLY, YEARLY
  accrualAmount     Float          @default(0)
  isPaid            Boolean        @default(true)
  allowHalfDay      Boolean        @default(true)
  carryForward      Boolean        @default(false)
  carryForwardLimit Int            @default(0)
  companyId         Int
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  allocated   Float     @default(0)
  used        Float     @default(0)
  carriedOver Float     @default(0)
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     Int
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  isHalfDay       Boolean   @default(false)
  halfDayPeriod   String? // AM, PM
  reason          String?
  attachmentUrl   String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  approvedById    Int?
  approvedBy      User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Attendance {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  clockIn       DateTime?
  clockOut      DateTime?
  clockInLat    Float?
  clockInLng    Float?
  clockOutLat   Float?
  clockOutLng   Float?
  overtimeHours Float     @default(0)
  status        String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  isLate        Boolean   @default(false)
  isEarlyLeave  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, date])
}

model AttendanceRegularization {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime  @db.Date
  proposedClockIn  DateTime?
  proposedClockOut DateTime?
  reason           String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason  String?
  approvedById     Int?
  approvedBy       User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Shift {
  id                Int        @id @default(autoincrement())
  name              String
  startTime         String // format "HH:mm"
  endTime           String // format "HH:mm"
  bufferTimeMinutes Int        @default(15)
  companyId         Int
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees         Employee[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model ShiftRotation {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  rotationType String     @default("WEEKLY") // WEEKLY, BIWEEKLY, MONTHLY
  shiftIds     String // JSON array of shift IDs in order
  companyId    Int
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees    Employee[] // Employees assigned to this rotation
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Payroll & Expenses
model SalaryComponent {
  id               Int               @id @default(autoincrement())
  name             String
  type             String // EARNING or DEDUCTION
  isPreDefined     Boolean           @default(false)
  description      String?
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryStructures SalaryStructure[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SalaryStructure {
  id          Int             @id @default(autoincrement())
  employeeId  Int
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId Int
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  amount      Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, componentId])
}

model Payslip {
  id              Int           @id @default(autoincrement())
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int // 1-12
  year            Int
  workingDays     Int           @default(30)
  presentDays     Float         @default(0)
  absentDays      Float         @default(0)
  halfDays        Float         @default(0)
  totalEarnings   Float         @default(0)
  totalDeductions Float         @default(0)
  lossOfPay       Float         @default(0)
  expenseAmount   Float         @default(0)
  netPay          Float         @default(0)
  status          String        @default("DRAFT") // DRAFT, FINALIZED, PAID
  paidOn          DateTime?
  items           PayslipItem[]
  companyId       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, month, year])
}

model PayslipItem {
  id            Int      @id @default(autoincrement())
  payslipId     Int
  payslip       Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentName String
  type          String // EARNING, DEDUCTION, EXPENSE
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ExpenseClaim {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  amount          Float
  category        String    @default("OTHER") // TRAVEL, MEALS, ACCOMMODATION, EQUIPMENT, OTHER
  receiptUrl      String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  approvedById    Int?
  approvedBy      User?     @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month           Int?
  year            Int?
  purchaseDate    DateTime?
  purchasedFrom   String?
  projectId       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Appreciation & Awards
model AwardType {
  id            Int            @id @default(autoincrement())
  title         String
  icon          String         @default("trophy") // trophy, ribbon, star, award, gift, thumbsup
  color         String         @default("orange") // orange, purple, blue, green, red, yellow
  status        Boolean        @default(true)
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appreciations Appreciation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Appreciation {
  id          Int       @id @default(autoincrement())
  awardTypeId Int
  awardType   AwardType @relation(fields: [awardTypeId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  givenDate   DateTime
  summary     String    @db.Text
  photoUrl    String?
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Assets & IT Management
model Asset {
  id                Int               @id @default(autoincrement())
  assetTag          String
  name              String
  category          String            @default("LAPTOP") // LAPTOP, DESKTOP, MONITOR, PERIPHERAL, SOFTWARE, MOBILE, OTHER
  brand             String?
  model             String?
  serialNumber      String?
  purchaseDate      DateTime?
  cost              Float?
  warrantyExpiry    DateTime?
  images            String?           @db.Text
  status            String            @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_REPAIR, RETIRED
  companyId         Int
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments       AssetAssignment[]
  fulfilledRequests HardwareRequest[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model AssetAssignment {
  id                Int       @id @default(autoincrement())
  assetId           Int
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        Int
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate      DateTime  @default(now())
  returnDate        DateTime?
  conditionOnAssign String?
  conditionOnReturn String?
  notes             String?   @db.Text
  status            String    @default("ACTIVE") // ACTIVE, RETURNED
  companyId         Int
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model HardwareRequest {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType      String   @default("NEW_DEVICE") // NEW_DEVICE, REPLACEMENT, REPAIR, PERIPHERAL
  category         String   @default("LAPTOP")
  urgency          String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  reason           String   @db.Text
  images           String?  @db.Text
  status           String   @default("PENDING") // PENDING, APPROVED, FULFILLED, REJECTED
  rejectionReason  String?
  fulfilledAssetId Int?
  fulfilledAsset   Asset?   @relation(fields: [fulfilledAssetId], references: [id], onDelete: SetNull)
  approvedById     Int?
  approvedBy       User?    @relation("HardwareApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Recruitment & ATS
model Job {
  id                 Int              @id @default(autoincrement())
  title              String
  departmentId       Int?
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId      Int?
  designation        Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branchId           Int?
  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  experienceYears    String?
  type               String           @default("Full-time")
  status             String           @default("Draft") // Open, Draft, Closed
  minSalary          Float?
  maxSalary          Float?
  discloseSalary     Boolean          @default(false)
  descriptionHtml    String?          @db.Text
  screeningQuestions String?          @db.Text // Store as JSON string or comma-separated
  companyId          Int
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedDate         DateTime?
  startDate          DateTime?
  endDate            DateTime?
  totalOpenings      Int              @default(1)
  recruiterId        Int?
  recruiter          Employee?        @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  workLocationType   String           @default("On-site") // On-site, Remote, Hybrid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       JobApplication[]
}

model JobApplication {
  id              Int         @id @default(autoincrement())
  jobId           Int
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  phone           String
  resumeUrl       String?
  linkedinUrl     String?
  portfolioUrl    String?
  experienceYears String?
  noticePeriod    String?
  status          String      @default("NEW") // NEW, REVIEWING, SHORTLISTED, REJECTED, HIRED, ONBOARDED
  offeredSalary   Float?
  approvalStatus  String?     @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED
  answers         String?     @db.Text // Store JSON string of answers
  aiScore         Int?
  aiSummary       String?     @db.Text
  isAiScored      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  interviews      Interview[]

  @@unique([jobId, email])
}

model Interview {
  id            Int            @id @default(autoincrement())
  applicationId Int
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId Int?
  interviewer   Employee?      @relation(fields: [interviewerId], references: [id], onDelete: SetNull)
  title         String // e.g. "Technical Round 1"
  scheduledAt   DateTime
  durationMins  Int            @default(30)
  locationUrl   String? // Google Meet / Zoom link
  status        String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  rating        Int? // Scorecard rating (1-5)
  feedback      String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ═══════════════════════════════════════════
// PROJECT MANAGEMENT MODULE
// ═══════════════════════════════════════════

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  key         String // Auto-generated, unique per company (e.g., "NEX")
  description String?
  color       String    @default("#2563eb") // Project accent color
  icon        String    @default("folder") // Lucide icon name
  status      String    @default("ACTIVE") // ACTIVE, ARCHIVED
  leadId      Int? // Project lead (Employee)
  lead        Employee? @relation("ProjectLead", fields: [leadId], references: [id])
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Client & Billing
  clientId     Int?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startDate    DateTime?
  endDate      DateTime?
  billingType  String    @default("NON_BILLABLE") // NON_BILLABLE, HOURLY, FIXED_PRICE
  budgetAmount Float?
  hourlyRate   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ProjectMember[]
  boards  Board[]
  issues  Issue[]
  labels  Label[]

  // AI Onboarding
  onboardingStatus String @default("DRAFT") // DRAFT, DOCUMENTS_UPLOADED, ANALYZING, ANALYZED, UNDER_REVIEW, CHANGES_REQUIRED, APPROVED, READY_FOR_KICKOFF, IN_PROGRESS, COMPLETED, ERROR

  documents    ProjectDocument[]
  analysisRuns ProjectAnalysisRun[]

  @@unique([key, companyId])
}

model ProjectDocument {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  url        String // ImageKit URL
  fileId     String? // ImageKit fileId
  type       String // MIME type or category (e.g. SOW, RFP)
  rawText    String?  @db.Text
  status     String   @default("PENDING") // PENDING, EXTRACTED, ERROR
  uploadedBy Int
  employee   Employee @relation(fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectAnalysisRun {
  id                 Int     @id @default(autoincrement())
  projectId          Int
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version            Int     @default(1)
  status             String  @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  aiModel            String  @default("llama3-70b-8192")
  promptVersion      String?
  documentsAnalyzed  Int     @default(0)
  processingDuration Int? // in milliseconds
  overallConfidence  Float?
  errorMessage       String? @db.Text

  // Validation & Normalization Layer
  totalCost          Float?
  costCurrency       String?
  costBreakdown      Json?
  costTotalMismatch  Boolean?
  estimatedRevenue   Float?
  estimatedMarginPct Float?
  marginDisplay      String?

  readinessScore  Int?
  healthStatus    String?
  healthBreakdown Json?

  validationWarnings Json?
  isReadyForKickoff  Boolean?
  kickoffBlockers    Json?

  resourceConstraints Json? // { engineerCount: number, maxDailyHours: number, daysOff: string[], startDate: string }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI Generated Entities
  summary          ProjectSummary?
  scope            ProjectScope?
  requirements     ProjectRequirement[]
  wbsTasks         ProjectWbsTask[]
  resourcePlans    ProjectResourcePlan[]
  costEstimate     ProjectCostEstimate?
  roadmap          ProjectRoadmap?
  milestones       ProjectMilestone[]
  risks            ProjectRisk[]
  dependencies     ProjectDependency[]
  assumptions      ProjectAssumption[]
  stakeholders     ProjectStakeholder[]
  raci             ProjectRaci[]
  openQuestions    ProjectOpenQuestion[]
  missingInfo      ProjectMissingInfo[]
  recommendations  ProjectRecommendation[]
  aiConfidence     ProjectAiConfidence?
  health           ProjectHealth?
  kickoffReadiness ProjectKickoffReadiness?
}

model ProjectSummary {
