  scopeApproved      Boolean @default(false)
  budgetApproved     Boolean @default(false)
  resourcesAvailable Boolean @default(false)
  timelineFeasible   Boolean @default(false)
  stakeholdersIded   Boolean @default(false)
  dependenciesIded   Boolean @default(false)
  risksReviewed      Boolean @default(false)
