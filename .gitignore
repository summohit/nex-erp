# Environment variables
.env
*.env
backend/.env
# Timestamped .env backups (.env.bak.181205) end in digits, so *.env misses them.
.env.*
*.env.*
!.env.example
!*.env.example

# Build outputs & node_modules
backend/dist/
backend/node_modules/
frontend/dist/
frontend/node_modules/
backend/uploads/

# System files
.DS_Store
*.log

# Temporary debug scripts (may contain local credentials)
backend/_tmp_*.js

# Python scraper
scraper/.venv/
scraper/out/
scraper/auth/
scraper/__pycache__/
*.partial.jsonl

# Firebase credentials. The service account's private key can push to every
# device in the project, so the real file never enters the repository —
# backend/config/firebase.example.json documents its shape.
backend/config/firebase.json

# Scraped Workway exports that carry pay data.
# out_hr/ is otherwise tracked (attendance, roster), but these two exports hold
# per-employee hourly rates, and a rate committed here is in the history for
# good. Both are reproducible: workway_timelogs.py and workway_profile.py.
scraper/out_hr/timelogs-*.json
scraper/out_hr/timelogs-*.csv
scraper/out_hr/profiles-*.json
scraper/out_hr/
scraper/out_finance/
scraper/out_*/
backend/scripts/backfill-clockin-2026-09-23.js
