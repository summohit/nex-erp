# Release signing credentials for the Android build.
#
# Copy this file to `keystore.properties` (same directory) and fill in the
# values you chose when generating the keystore. The real file is gitignored;
# this .example is the only one that belongs in version control.
#
# ---------------------------------------------------------------------------
# 1. Generate the keystore (run from the mobile/android directory):
#
#      keytool -genkeypair -v \
#        -storetype PKCS12 \
#        -keystore nex-release.keystore \
#        -alias nex-release \
#        -keyalg RSA -keysize 2048 -validity 10000
#
#    keytool will prompt for a password and for your org details. Do NOT pass
#    the password with -storepass on the command line — it would be recorded in
#    your shell history.
#
# 2. Fill in keystore.properties with the alias and password you just chose.
#
# ---------------------------------------------------------------------------
# BACK UP `nex-release.keystore` AND ITS PASSWORD SOMEWHERE SAFE AND DURABLE
# (a password manager, not just this laptop).
#
# This key is permanent and irreplaceable. Android refuses to install an update
# whose signing certificate differs from the installed version, so if you lose
# this file or forget the password you can never ship an update to anyone who
# already installed the app — they would all have to uninstall and lose their
# local data. There is no recovery process.
# ---------------------------------------------------------------------------

storeFile=nex-release.keystore
storePassword=
keyAlias=nex-release
keyPassword=
